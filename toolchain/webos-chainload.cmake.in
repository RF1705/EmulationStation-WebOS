set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_C_COMPILER "@CC@")
set(CMAKE_CXX_COMPILER "@CXX@")
set(CMAKE_AR "@AR@")
set(CMAKE_RANLIB "@RANLIB@")
set(CMAKE_STRIP "@STRIP@")
set(CMAKE_SYSROOT "@SYSROOT@")
set(CMAKE_C_FLAGS_INIT "@CFLAGS@")
set(CMAKE_CXX_FLAGS_INIT "@CXXFLAGS@")
set(CMAKE_EXE_LINKER_FLAGS_INIT "@LDFLAGS@")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "@LDFLAGS@")

# Some dependencies build static helper libraries and link them into shared
# libraries. ARM requires those objects to be compiled as position-independent
# code as well.
set(CMAKE_POSITION_INDEPENDENT_CODE ON CACHE BOOL "Build position-independent target code" FORCE)

set(CMAKE_FIND_ROOT_PATH "@SYSROOT@")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)

# The SDK sysroot includes CMake package metadata for libraries such as Boost.
# Do not let those package configs shadow the versions built and managed by
# vcpkg. Target headers and libraries from the sysroot remain discoverable.
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE NEVER)
